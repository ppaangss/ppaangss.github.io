---
---
{%- comment -%}
  지식 그래프 데이터 — 발행 글 전체에서 자동 생성.
  path = front matter categories, chars = 본문 글자 수 (HTML 태그·공백·줄바꿈 제외),
  featured = 홈 인기글 (featured: true 글 중 최신 3개)
{%- endcomment -%}
{%- assign featured_urls = "" -%}
{%- assign featured_posts = site.posts | where: "featured", true -%}
{%- for f in featured_posts limit: 3 -%}{%- assign featured_urls = featured_urls | append: f.url | append: " " -%}{%- endfor -%}
{
  "nodes": [
    {%- for post in site.posts %}
    {%- assign body = post.content | strip_html | strip_newlines | remove: " " | remove: "	" %}
    {
      "id": {{ post.slug | jsonify }},
      "title": {{ post.title | jsonify }},
      "path": {{ post.categories | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "published": true,
      "featured": {% if featured_urls contains post.url %}true{% else %}false{% endif %},
      "chars": {{ body | size }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ],
  "links": []
}
